#!/usr/bin/env python3
import subprocess
import sys

partition, output_dir, manifest, runtime = sys.argv[1:]
main_object = output_dir + "/main.o"
runtime_object = output_dir + "/runtime.o"
start_object = output_dir + "/start.o"
observer_object = output_dir + "/observer.o"
clang = ["clang", "--target=wasm32-wasi", "-O0", "-c"]
for source, object_file in (
    (partition, main_object), (runtime, runtime_object), ("scripts/start.ll", start_object),
):
    subprocess.run([*clang, "-x", "ir", source, "-o", object_file], check=True)

suffix = "__".join(part.encode().hex() for part in ("probe", "fixture_resource", "checkpoint"))
(checkpoint,) = (
    symbol for symbol in subprocess.check_output(
        ["llvm-nm", "--undefined-only", "--just-symbol-name", main_object], text=True,
    ).splitlines()
    if symbol.startswith("wosy_extern__") and symbol.endswith("__" + suffix)
)
subprocess.run([
    *clang, "-ffreestanding", "-Wall", "-Wextra", "-Werror",
    f"-DCHECKPOINT={checkpoint}", "scripts/observer.c", "-o", observer_object,
], check=True)
subprocess.run([
    "wasm-ld", "--no-entry", "--export=_start", "-z", "stack-size=32768",
    "--wrap=__wosy_core_alloc", "--wrap=__wosy_core_free",
    main_object, start_object, runtime_object, observer_object, "-o", output_dir + "/main",
], check=True)
