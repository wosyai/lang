#!/usr/bin/env python3
"""Golden-partition gate for the pointer-cast-address fixture.

Project IR symbol names are stable: they encode only
`[package, path, revision, name]` (never the absolute temporary build
directory), and the module header carries the entry `source.path`. The
partition is therefore byte-identical on every harness run, so the golden
in `expected/partition_address.ll` pins the full IR with an exact compare.
This script:

1. Verifies the properties the golden carries, on the single project
   `run` function slice (package `pointer-cast-address`):
     - the `&?bytes` place address reaches the bound `base` slot with a
       plain `store i32` line: the `core.pointer_cast<*?u8>` emits no
       conversion instruction (`bitcast` is absent);
     - element reads lower mechanically: three
       `getelementptr inbounds i8` offset sites and eight
       `load i8` read sites (four element reads plus their format reloads);
     - the pure raw path carries no guard code (`deref_null` is absent).
2. Copies the partition verbatim to `partition.normalized.ll` for the
   exact-compare file assert in case.toml. No normalization remains: there
   is no absolute path material left to strip.

Reads `.wosy/artifacts/app/dev/main/partition.ll`, writes
`partition.normalized.ll`. Exits 0 when every property holds, 1 with
diagnostics otherwise.
"""

import re
import shutil
import sys

PARTITION = ".wosy/artifacts/app/dev/main/partition.ll"
NORMALIZED = "partition.normalized.ll"

PACKAGE = "706f696e7465722d636173742d61646472657373"


def project_slice(text):
    bodies = [
        match.group(0)
        for match in re.finditer(
            r"define [^\n]*" + PACKAGE + r"[^\n]*\n(?:(?!define ).*\n?)*", text
        )
    ]
    return bodies


def main():
    try:
        with open(PARTITION, encoding="utf-8") as file:
            text = file.read()
    except OSError as error:
        print(f"check-partition: cannot read {PARTITION}: {error}")
        return 1
    failures = []
    bodies = project_slice(text)
    if len(bodies) != 1:
        failures.append(f"expected one project function, found {len(bodies)}")
        body = ""
    else:
        body = bodies[0]
    if "676c6f62616c5f6279746573" not in body:
        failures.append("missing address formation from the bytes global")
    if "ptr %base" not in body:
        failures.append("missing pass-through store into the cast address")
    offsets = re.findall(r"getelementptr inbounds i8, ptr %offset_base", body)
    if len(offsets) != 3:
        failures.append(f"expected 3 offset sites, found {len(offsets)}")
    loads = re.findall(r"load i8", body)
    if len(loads) < 8:
        failures.append(f"expected at least 8 raw read sites, found {len(loads)}")
    if "deref_null" in body:
        failures.append("unexpected guard code on the pure raw path")
    if "bitcast" in body:
        failures.append("unexpected bitcast conversion in project function")
    if failures:
        for failure in failures:
            print(f"check-partition: {failure}")
        return 1
    try:
        shutil.copyfile(PARTITION, NORMALIZED)
    except OSError as error:
        print(f"check-partition: cannot write {NORMALIZED}: {error}")
        return 1
    print(
        "check-partition: place address pass-through present "
        f"({len(offsets)} offsets, {len(loads)} raw reads), "
        "no guards, no bitcast"
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
