#!/usr/bin/env python3
import subprocess
import sys

partition, output_dir, manifest, runtime = sys.argv[1:]
main_object = output_dir + "/main.obj"
subprocess.run(
    ["clang", "-O0", "-c", "-x", "ir", partition, "-o", main_object],
    check=True,
)
undefined_symbols = subprocess.check_output(
    ["llvm-nm", "--undefined-only", "--just-symbol-name", main_object], text=True,
).splitlines()
stdin_suffix = "__".join(part.encode().hex() for part in ("host", "fixture_stdin", "getchar"))
(stdin_symbol,) = (
    symbol for symbol in undefined_symbols
    if symbol.startswith("wosy_extern__") and symbol.endswith("__" + stdin_suffix)
)
subprocess.run(
    ["clang", "-O0", "-fuse-ld=lld", main_object, "-x", "ir", runtime,
     "-Xlinker", f"/alternatename:{stdin_symbol}=getchar",
     "-Xlinker", "/stack:1048576,65536", "-o", output_dir + "/main"],
    check=True,
)
