#!/usr/bin/env python3
"""Check direct checked dereferences in the emitted project IR and pin its full partition."""

import json
import re
import shutil
import sys

PARTITION = ".wosy/artifacts/app/dev/main/partition.ll"
OUTPUT = "partition.normalized.ll"
PACKAGE = "706f696e7465722d636173742d6469726563742d6465726566"


def require(condition, message):
    if not condition:
        raise ValueError(message)


def release_non_null_symbol():
    artifact = ".wosy/artifacts/app/dev/main/artifact-manifest.json"
    with open(artifact, encoding="utf-8") as file:
        observations = json.load(file)["source_observations"]
    qualified = [
        entry for entry in observations
        if entry["source"]["project"] == "wosy-release://stdlib"
        and entry["source"]["package"] == "wosy_toolchain_stdlib"
        and entry["source"]["path"].replace(chr(92), "/") == "src/checked_access.w"
    ]
    if len(qualified) != 1:
        raise ValueError("expected one qualified release checked-access observation")
    revision = qualified[0]["content_revision"]
    if not re.fullmatch(r"[0-9a-f]{64}", revision):
        raise ValueError("invalid release checked-access revision")
    fields = ("wosy_toolchain_stdlib", "src/checked_access.w", revision, "check_non_null_address")
    return "wosy_fn__" + "__".join(field.encode().hex() for field in fields)


def inspect(partition):
    functions = re.findall(r"(?ms)^define [^\n]+\{\n.*?^\}", partition)
    project = [body for body in functions if f"@wosy_fn__{PACKAGE}__" in body.splitlines()[0]]
    require(len(project) == 1 and "__72756e()" in project[0].splitlines()[0], "expected one project run function")
    body = project[0]
    require("call ptr @__wosy_core_alloc(i64 1, i64 1)" in body, "missing aligned raw allocation")
    require(re.search(r"%raw\d* = load i32, ptr %raw, align 4\n  store i32 %raw\d*, ptr %writer", body), "bound mutable cast must pass through the raw pointer")
    require("bitcast" not in body, "unexpected cast instruction")
    require(not re.search(r"call void @wosy_fn__[^ (]+__" + "check_index_in_extent".encode().hex() + r"\(", body),
            "these pointer-only accesses have no fixed-array extent")

    guard = release_non_null_symbol()
    definition = [fn for fn in functions if f"@{guard}(" in fn.splitlines()[0]]
    require(len(definition) == 1, "expected one ordinary release helper definition")
    require(re.search(r"icmp eq i32 %\w+, 0", definition[0])
            and definition[0].count("call void @__wosy_core_system_panic()") == 1,
            "release helper must retain the ordinary null trap")
    require("deref_is_null" not in body and "deref_null" not in body,
            "legacy inline null guard must not remain")
    calls = list(re.finditer(r"call void @" + re.escape(guard) + r"\(i32 (%\w+)\)", body))
    require(len(calls) == 6, f"expected six release null checks, found {len(calls)}")
    require(len(re.findall(r"call void @wosy_fn__[^ (]+__" + "check_non_null_address".encode().hex() + r"\(", body)) == len(calls),
            "unexpected noncanonical null-check call")
    destinations = ["writer", "shared_scalar", "mutable_scalar", "writer", "shared_field", "mutable_field"]
    for i, (call, destination) in enumerate(zip(calls, destinations)):
        address = call.group(1)
        end = calls[i + 1].start() if i + 1 < len(calls) else len(body)
        instructions = body[call.end():end]
        cast = re.match(r"\n  (%deref\d*) = inttoptr i32 " + re.escape(address) + r" to ptr", instructions)
        require(cast, f"{destination} must convert the same guarded address immediately after the check")
        if "scalar" in destination:
            access = re.search(r"%place\d* = load i8, ptr " + re.escape(cast.group(1)) + r", align 1\n  store i8 %place\d*, ptr %" + destination, instructions)
            require(access and cast.end() < access.start(), f"scalar load must follow the guard for {destination}")
        else:
            field = re.search(r"(%tag\d*) = getelementptr inbounds i8, ptr " + re.escape(cast.group(1)) + r", i8 0", instructions)
            require(field and cast.end() < field.start(), f"field GEP must follow the guard for {destination}")
            if destination == "writer":
                require(re.search(r"store i8 %assignment_value\d*, ptr " + re.escape(field.group(1)), instructions[field.end():]),
                        "guarded writer field store missing")
            else:
                access = re.search(r"%place\d* = load i8, ptr " + re.escape(field.group(1)) + r", align 1\n  store i8 %place\d*, ptr %" + destination, instructions)
                require(access and field.end() < access.start(), f"field load must follow guarded GEP for {destination}")
        if destination != "writer":
            require(re.search(re.escape(address) + r" = load i32, ptr %raw, align 4\n  $", body[:call.start()]),
                    f"direct cast must flow unchanged into the release guard for {destination}")


def main():
    try:
        with open(PARTITION, encoding="utf-8") as file:
            inspect(file.read())
        shutil.copyfile(PARTITION, OUTPUT)
    except (OSError, ValueError, KeyError) as error:
        print(f"check-partition: {error}")
        return 1
    print("check-partition: four direct reads guarded before scalar/field access; pure cast and exact guard count")
    return 0


if __name__ == "__main__":
    sys.exit(main())
