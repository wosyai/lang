#!/usr/bin/env python3
import subprocess
import sys

partition, output_dir, manifest, runtime = sys.argv[1:]
objects = []
for name, path in [("main", partition), ("start", "scripts/global-start.ll"), ("runtime", runtime), ("counting", "runtime/global-wasm32.ll")]:
    object_path = output_dir + "/" + name + ".o"
    subprocess.run(["clang", "--target=wasm32-wasi", "-c", "-x", "ir", path, "-o", object_path], check=True)
    objects.append(object_path)
subprocess.run(["wasm-ld", "--no-entry", "--allow-undefined", "--export=_start", "--wrap=__wosy_core_alloc", "--wrap=__wosy_core_free", *objects, "-o", output_dir + "/main"], check=True)
