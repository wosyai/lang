#!/usr/bin/env python3
"""Golden-partition gate for the pointer-cast-checked fixture.

Project IR symbol names are stable: they encode only
`[package, path, revision, name]` (never the absolute temporary build
directory), and the module header carries the entry `source.path`. The
partition is therefore byte-identical on every harness run, so the golden
in `expected/partition_checked.ll` pins the full IR with an exact compare.
This script:

1. Verifies the properties the golden carries, on the single project
   `run` function slice (package `pointer-cast-checked`):
     - both assertion directions lower as pure same-width value flow:
       the cast results land in the bound `shared` (`*u8`) and `writer`
       (`*!u8`) slots with plain `store i32` lines and no conversion
       instruction (`bitcast` is absent);
     - every bound checked use keeps its null guard (`deref_null`
       sites present for the shared read, the exclusive reads, and the
       exclusive writes).
2. Copies the partition verbatim to `partition.normalized.ll` for the
   exact-compare file assert in case.toml. No normalization remains: there
   is no absolute path material left to strip.

Reads `.wosy/artifacts/app/dev/main/partition.ll`, writes
`partition.normalized.ll`. Exits 0 when every property holds, 1 with
diagnostics otherwise.
"""

import re
import shutil
import sys

PARTITION = ".wosy/artifacts/app/dev/main/partition.ll"
NORMALIZED = "partition.normalized.ll"

PACKAGE = "706f696e7465722d636173742d636865636b6564"


def project_slice(text):
    bodies = [
        match.group(0)
        for match in re.finditer(
            r"define [^\n]*" + PACKAGE + r"[^\n]*\n(?:(?!define ).*\n?)*", text
        )
    ]
    return bodies


def main():
    try:
        with open(PARTITION, encoding="utf-8") as file:
            text = file.read()
    except OSError as error:
        print(f"check-partition: cannot read {PARTITION}: {error}")
        return 1
    failures = []
    bodies = project_slice(text)
    if len(bodies) != 1:
        failures.append(f"expected one project function, found {len(bodies)}")
        body = ""
    else:
        body = bodies[0]
    if "call ptr @__wosy_core_alloc(i64 2, i64 1)" not in body:
        failures.append("missing 2-byte checked storage allocation site")
    if "ptr %shared" not in body:
        failures.append("missing pass-through store into the shared assertion")
    if "ptr %writer" not in body:
        failures.append("missing pass-through store into the exclusive assertion")
    guards = re.findall(r"deref_null", body)
    if not guards:
        failures.append("missing null guards on the bound checked uses")
    if "bitcast" in body:
        failures.append("unexpected bitcast conversion in project function")
    if failures:
        for failure in failures:
            print(f"check-partition: {failure}")
        return 1
    try:
        shutil.copyfile(PARTITION, NORMALIZED)
    except OSError as error:
        print(f"check-partition: cannot write {NORMALIZED}: {error}")
        return 1
    print(
        "check-partition: shared/exclusive pass-through stores present, "
        f"checked-use guards present (x{len(guards)}), no bitcast"
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
