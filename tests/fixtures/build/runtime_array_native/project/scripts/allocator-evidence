#!/usr/bin/env python3
import subprocess
import sys

runtime = ".wosy/artifacts/app/dev/main/runtime.ll"
evidence = """declare ptr @__wosy_core_alloc(i64, i64)
declare void @__wosy_core_free(ptr)
declare void @__wosy_core_system_panic()
declare void @exit(i32)

define i32 @main() {
entry:
  %pointer = call ptr @__wosy_core_alloc(i64 1, i64 64)
  %allocated = icmp ne ptr %pointer, null
  br i1 %allocated, label %alignment, label %allocation_failed
allocation_failed:
  ret i32 10
alignment:
  %address = ptrtoint ptr %pointer to i64
  %mask = and i64 %address, 63
  %is_aligned = icmp eq i64 %mask, 0
  br i1 %is_aligned, label %release, label %alignment_failed
alignment_failed:
  ret i32 11
release:
  call void @__wosy_core_free(ptr %pointer)
  %reused = call ptr @__wosy_core_alloc(i64 1, i64 64)
  %is_reused = icmp ne ptr %reused, null
  br i1 %is_reused, label %overflow, label %reuse_failed
reuse_failed:
  ret i32 12
overflow:
  %overflow_pointer = call ptr @__wosy_core_alloc(i64 -1, i64 64)
  %overflow_failed = icmp eq ptr %overflow_pointer, null
  br i1 %overflow_failed, label %complete, label %overflow_failed_block
overflow_failed_block:
  ret i32 13
complete:
  call void @__wosy_core_free(ptr %reused)
  ret i32 0
}
"""
with open("allocator-evidence.ll", "w", encoding="utf-8") as file:
    file.write(evidence)
subprocess.run(["clang", "-x", "ir", "allocator-evidence.ll", runtime, "-o", "allocator-evidence.exe"], check=True)
subprocess.run(["allocator-evidence.exe"], check=True)
with open("allocator-panic.ll", "w", encoding="utf-8") as file:
    file.write("declare void @__wosy_core_system_panic()\ndefine i32 @main() { entry: call void @__wosy_core_system_panic() unreachable }\n")
subprocess.run(["clang", "-x", "ir", "allocator-panic.ll", runtime, "-o", "allocator-panic.exe"], check=True)
panic = subprocess.run(["allocator-panic.exe"])
sys.exit(0 if panic.returncode == 1 else 1)
