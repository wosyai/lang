#!/usr/bin/env python3
import subprocess
import sys

partition, output_dir, manifest = sys.argv[1:]
if sys.platform == "win32":
    command = ["clang", "-x", "ir", partition, "-fuse-ld=lld", "-Xlinker", "/force:unresolved", "-Xlinker", "/fixed", "-o", output_dir + "/main"]
else:
    command = ["clang", "-x", "ir", partition, "-no-pie", "-Wl,--unresolved-symbols=ignore-all", "-o", output_dir + "/main"]
subprocess.run(command, check=True)
