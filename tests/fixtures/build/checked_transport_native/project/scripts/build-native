#!/usr/bin/env python3
import subprocess
import sys

partition, output_dir, manifest, runtime = sys.argv[1:]
main_object = output_dir + "/main.obj"
runtime_object = output_dir + "/runtime.obj"
observer_object = output_dir + "/observer.obj"
for source, object_file in ((partition, main_object), (runtime, runtime_object)):
    subprocess.run(["clang", "-O0", "-c", "-x", "ir", source, "-o", object_file], check=True)

symbols = subprocess.check_output(
    ["llvm-nm", "--undefined-only", "--just-symbol-name", main_object], text=True,
).splitlines()


def extern_symbol(member):
    suffix = "__".join(part.encode().hex() for part in ("probe", "fixture_transport", member))
    (symbol,) = (
        name for name in symbols
        if name.startswith("wosy_extern__") and name.endswith("__" + suffix)
    )
    return symbol


subprocess.run([
    "clang", "-O0", "-ffreestanding", "-Wall", "-Wextra", "-Werror", "-c",
    f"-DCHECKPOINT={extern_symbol('checkpoint')}", f"-DWRITE_BYTE={extern_symbol('write_byte')}",
    "scripts/observer.c", "-o", observer_object,
], check=True)
subprocess.run([
    "clang", "-fuse-ld=lld", main_object, runtime_object, observer_object,
    "-Xlinker", "/stack:1048576,65536", "-o", output_dir + "/main",
], check=True)
