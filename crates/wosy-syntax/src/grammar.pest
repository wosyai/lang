WHITESPACE = _{ " " | "\t" | "\r" | "\n" | comment }
comment = { "#" ~ " "* ~ (typed_comment | untyped_comment) }
typed_comment = { comment_category ~ ":" ~ comment_payload }
untyped_comment = { comment_category }
comment_category = @{ (!(":" | "\r" | "\n") ~ ANY)* }
comment_payload = @{ (!("\r" | "\n") ~ ANY)* }
comment_scan = ${ SOI ~ (string | comment | (!("\"" | "#") ~ ANY))* ~ EOI }

source = { SOI ~ boundary_start ~ (item | error_item)+ ~ boundary_end ~ EOI }
boundary_start = { "%%start" }
boundary_end = { "%%end" }
item = { struct_decl | namespace_decl | extern_decl | function_decl | binding_decl | top_level_item }
error_item = @{ (!(";" | "%%end") ~ ANY)+ ~ ";"? }
top_level_item = { (assignment | expression) ~ ";" }
struct_decl = { "struct" ~ identifier ~ "{" ~ struct_field* ~ "}" }
struct_field = { type_spec ~ identifier ~ ";" }
namespace_decl = { identifier ~ "=" ~ "namespace" ~ identifier ~ string ~ ";" }
extern_decl = { identifier ~ "=" ~ "extern" ~ identifier ~ string ~ "{" ~ extern_function+ ~ "}" ~ ";" }
extern_function = { unsafe_marker? ~ callable_type ~ identifier ~ ";" }
function_decl = { callable_type ~ identifier ~ "=" ~ "fn" ~ parameters? ~ block ~ ";" }
binding_decl = { receiver_list ~ "=" ~ output_list ~ ";" }
type_spec = { callable_type | raw_pointer_type | qualified_type | type_name }
callable_type = { callable_output ~ "(" ~ ((raw_pointer_type | qualified_type | type_name) ~ ("," ~ (raw_pointer_type | qualified_type | type_name))*)? ~ ")" }
callable_output = { raw_pointer_type | qualified_type | type_name | "(" ~ (raw_pointer_type | qualified_type | type_name) ~ ("," ~ (raw_pointer_type | qualified_type | type_name))* ~ ")" }
raw_pointer_type = { "*?" ~ (qualified_type | type_name) }
type_name = @{ ASCII_ALPHA ~ (ASCII_ALPHANUMERIC | "_")* }
qualified_type = { identifier ~ "." ~ identifier }
unsafe_marker = { unsafe_keyword }
unsafe_keyword = { "unsafe" }
identifier = @{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }
parameters = { "(" ~ (identifier ~ ("," ~ identifier)*)? ~ ")" }
block = { "{" ~ block_item* ~ final_output_list? ~ "}" }
block_item = { local_binding | while_expr | expression ~ ";" }
final_output_list = { output_list }
local_binding = { receiver_list ~ "=" ~ output_list ~ ";" }
expression = { if_expr | unit_if_expr | unsafe_expr | assignment | logical_or }
if_expr = { "if" ~ "(" ~ expression ~ ")" ~ block ~ "else" ~ block }
unit_if_expr = { "if" ~ "(" ~ expression ~ ")" ~ block }
unsafe_expr = { unsafe_keyword ~ block }
while_expr = { "while" ~ "(" ~ expression ~ ")" ~ block }
assignment = { assignment_targets ~ "=" ~ output_list }
assignment_targets = { assignment_target ~ ("," ~ assignment_target)* }
assignment_target = { qualified_member | dereferenced_field | identifier }
receiver_list = { receiver ~ ("," ~ receiver)* }
receiver = { type_spec ~ identifier }
output_list = { expression ~ ("," ~ expression)* }
logical_or = { logical_and ~ (or_operator ~ logical_and)* }
logical_and = { bit_or ~ (and_operator ~ bit_or)* }
bit_or = { bit_xor ~ (bit_or_operator ~ bit_xor)* }
bit_xor = { bit_and ~ (bit_xor_operator ~ bit_and)* }
bit_and = { comparison ~ (bit_and_operator ~ comparison)* }
comparison = { shift ~ (comparison_operator ~ shift)* }
shift = { additive ~ (shift_operator ~ additive)* }
additive = { multiplicative ~ (add_operator ~ multiplicative)* }
multiplicative = { unary ~ (multiply_operator ~ unary)* }
unary = { unary_operator ~ unary | primary }
primary = { call | raw_address | field_access | dereference | struct_literal | boolean | identifier | float | integer | char | string | parenthesized }
parenthesized = { "(" ~ expression ~ ")" }
struct_literal = { "{" ~ struct_literal_field* ~ "}" }
struct_literal_field = { "." ~ identifier ~ "=" ~ expression ~ ";" }
raw_address = { "&?" ~ assignment_target }
dereference = { "*" ~ primary }
field_access = { qualified_member | dereferenced_field }
dereferenced_field = { parenthesized ~ "." ~ identifier }
call = { qualified_call ~ generic_type_arguments? ~ "(" ~ (expression ~ ("," ~ expression)*)? ~ ")" }
qualified_call = { identifier ~ ("." ~ identifier)? }
generic_type_arguments = { "<" ~ generic_type_argument ~ ("," ~ generic_type_argument)* ~ ">" }
generic_type_argument = { type_spec }
qualified_member = { identifier ~ "." ~ identifier }
or_operator = { "||" }
and_operator = { "&&" }
bit_or_operator = { "|" }
bit_xor_operator = { "^" }
bit_and_operator = { "&" }
shift_operator = { "<<" | ">>" }
unary_operator = { "!" | "~" | "-" }
comparison_operator = { "==" | "!=" | "<=" | ">=" | "<" | ">" }
add_operator = { "+" | "-" }
multiply_operator = { "*" | "/" | "%" }
operator = { or_operator | and_operator | comparison_operator | add_operator | multiply_operator }
boolean = { "true" | "false" }
integer = @{ ("0x" | "0X") ~ (ASCII_ALPHANUMERIC | "_")* | ("0b" | "0B") ~ (ASCII_ALPHANUMERIC | "_")* | ("0o" | "0O") ~ (ASCII_ALPHANUMERIC | "_")* | ASCII_DIGIT ~ (ASCII_ALPHANUMERIC | "_")* }
float = @{ ((ASCII_DIGIT | "_")+ ~ "." ~ (ASCII_DIGIT | "_")* ~ (("e" | "E") ~ ("+" | "-")? ~ (ASCII_ALPHANUMERIC | "_")*)?) | ((ASCII_DIGIT | "_")+ ~ ("e" | "E") ~ ("+" | "-")? ~ (ASCII_ALPHANUMERIC | "_")*) }
string = @{ "\"" ~ (string_escape | malformed_string_escape | ! ("\"" | "\\" | "\r" | "\n") ~ ANY)* ~ "\"" }
string_escape = { "\\" ~ ("\\" | "\"" | "'" | "n" | "r" | "t" | "0" | ("u{" ~ ASCII_HEX_DIGIT+ ~ "}")) }
malformed_string_escape = { "\\" ~ (! ("\"" | "\\" | "\r" | "\n") ~ ANY)+ }
char = @{ "'" ~ (string_escape | char_malformed_escape | ! ("'" | "\\" | "\r" | "\n") ~ ANY)* ~ "'" }
char_malformed_escape = { "\\" ~ (! ("'" | "\"" | "\\" | "\r" | "\n") ~ ANY)+ }
