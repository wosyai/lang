WHITESPACE = _{ " " | "\t" | "\r" | "\n" | comment }
comment = { "#" ~ " "* ~ (typed_comment | untyped_comment) }
typed_comment = { comment_category ~ ":" ~ comment_payload }
untyped_comment = { comment_category }
comment_category = @{ (!(":" | "\r" | "\n") ~ ANY)* }
comment_payload = @{ (!("\r" | "\n") ~ ANY)* }
comment_scan = ${ SOI ~ (string | comment | (!("\"" | "#") ~ ANY))* ~ EOI }

source = { SOI ~ boundary_start ~ (item | error_item)+ ~ boundary_end ~ EOI }
boundary_start = { "%%start" }
boundary_end = { "%%end" }
item = { namespace_decl | extern_decl | function_decl | binding_decl | top_level_item }
error_item = @{ (!(";" | "%%end") ~ ANY)+ ~ ";"? }
top_level_item = { (assignment | expression) ~ ";" }
namespace_decl = { identifier ~ "=" ~ "namespace" ~ identifier ~ string ~ ";" }
extern_decl = { identifier ~ "=" ~ "extern" ~ identifier ~ string ~ "{" ~ extern_function ~ "}" ~ ";" }
extern_function = { unsafe_marker? ~ callable_type ~ identifier ~ ";" }
function_decl = { callable_type ~ identifier ~ "=" ~ "fn" ~ parameters? ~ block ~ ";" }
binding_decl = { type_spec ~ identifier ~ "=" ~ expression ~ ";" }
type_spec = { callable_type | raw_pointer_type | type_name }
callable_type = { (raw_pointer_type | type_name) ~ "(" ~ ((raw_pointer_type | type_name) ~ ("," ~ (raw_pointer_type | type_name))*)? ~ ")" }
raw_pointer_type = { "*?" ~ type_name }
type_name = @{ ASCII_ALPHA ~ (ASCII_ALPHANUMERIC | "_")* }
unsafe_marker = { unsafe_keyword }
unsafe_keyword = { "unsafe" }
identifier = @{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }
parameters = { "(" ~ (identifier ~ ("," ~ identifier)*)? ~ ")" }
block = { "{" ~ block_item* ~ "}" }
block_item = { local_binding | while_expr | expression ~ ";"? }
local_binding = { type_spec ~ identifier ~ "=" ~ expression ~ ";" }
expression = { if_expr | assignment | logical_or }
if_expr = { "if" ~ "(" ~ expression ~ ")" ~ block ~ "else" ~ block }
while_expr = { "while" ~ "(" ~ expression ~ ")" ~ block }
assignment = { assignment_target ~ "=" ~ expression }
assignment_target = { qualified_member | identifier }
logical_or = { logical_and ~ (or_operator ~ logical_and)* }
logical_and = { comparison ~ (and_operator ~ comparison)* }
comparison = { additive ~ (comparison_operator ~ additive)* }
additive = { multiplicative ~ (add_operator ~ multiplicative)* }
multiplicative = { primary ~ (multiply_operator ~ primary)* }
primary = { call | qualified_member | boolean | identifier | integer | string | parenthesized }
parenthesized = { "(" ~ expression ~ ")" }
call = { qualified_call ~ "(" ~ (expression ~ ("," ~ expression)*)? ~ ")" }
qualified_call = { identifier ~ ("." ~ identifier)? }
qualified_member = { identifier ~ "." ~ identifier }
or_operator = { "||" }
and_operator = { "&&" }
comparison_operator = { "==" | "!=" | "<=" | ">=" | "<" | ">" }
add_operator = { "+" | "-" }
multiply_operator = { "*" | "/" | "%" }
operator = { or_operator | and_operator | comparison_operator | add_operator | multiply_operator }
boolean = { "true" | "false" }
integer = @{ ASCII_DIGIT+ }
string = @{ "\"" ~ (string_escape | malformed_string_escape | ! ("\"" | "\\" | "\r" | "\n") ~ ANY)* ~ "\"" }
string_escape = { "\\" ~ ("\\" | "\"" | "'" | "n" | "r" | "t" | "0" | ("u{" ~ ASCII_HEX_DIGIT+ ~ "}")) }
malformed_string_escape = { "\\" ~ (! ("\"" | "\\" | "\r" | "\n") ~ ANY)+ }
