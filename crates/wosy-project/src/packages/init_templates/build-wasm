#!/bin/sh
set -eu
clang --target=wasm32-wasi -c -x ir "$1" -o "$2/main.o"
clang --target=wasm32-wasi -c -x ir scripts/start.ll -o "$2/start.o"
clang --target=wasm32-wasi -c -x ir "$4" -o "$2/runtime.o"
exec wasm-ld --no-entry --allow-undefined --export=_start \
    "$2/main.o" "$2/start.o" "$2/runtime.o" -o "$2/main"
